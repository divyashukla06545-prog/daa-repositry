int tsp(int mask, int pos)
{
    int city;

    if(mask == (1 << n) - 1)
    {
        if(cost[pos][0] == -1)
            return INF;

        return cost[pos][0];
    }

    if(dp[mask][pos] != -1)
        return dp[mask][pos];

    dp[mask][pos] = INF;

    for(city = 0; city < n; city++)
    {
        if((mask & (1 << city)) == 0 && cost[pos][city] != -1)
		{             dp[mask][pos] = min(
                dp[mask][pos],
                cost[pos][city] + tsp(mask | (1 << city), city)
            );
        }
    }

    return dp[mask][pos];
}

int main()
{
    int i, j;

    scanf("%d", &n);

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &cost[i][j]);
        }
    }

    for(i = 0; i < (1 << n); i++)
    {
        for(j = 0; j < n; j++)
        {
            dp[i][j] = -1;
        }
    }

    printf("%d", tsp(1, 0));

    return 0;
}
