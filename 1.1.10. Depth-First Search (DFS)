void DFS(int start) {
    visited[start] = 1;

    printf("%d ", start);

    Node* curr = adjList[start];

    while (curr != NULL) {

        if (!visited[curr->vertex]) {
            DFS(curr->vertex);
        }

        curr = curr->next;
	}
    
